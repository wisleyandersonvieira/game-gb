# O endereco e a chave PUBLICA do Supabase ficam no codigo
# (src/integrations/supabase/config-publica.ts), nao aqui.

# Para onde o link do convite leva. Precisa bater com a lista de URLs
# permitidas no Supabase (Authentication -> URL Configuration).
SITE_URL="http://localhost:8080"

# SEGREDO. Da acesso total ao banco, ignorando a RLS.
# Nunca use o prefixo VITE_ aqui: isso a mandaria para o navegador.
# Pegue em: Supabase -> Project Settings -> API Keys -> service_role (Reveal).
# Na publicacao (Lovable -> Secrets) o nome e o mesmo: STGAME_SERVICE_ROLE_KEY.
STGAME_SERVICE_ROLE_KEY=""

# SEGREDO. Embaralha o PIN e a senha interna dos acessos (Etapa 1.12).
# Pelo menos 16 caracteres, aleatorios. Na publicacao, Lovable -> Secrets, com
# o mesmo nome. NUNCA troque depois: todos os acessos precisariam ser refeitos.
# Nao e usada em nenhuma Edge Function do Supabase: so nas funcoes de servidor.
STGAME_PIN_PEPPER=""

# Chave para ver o DETALHE da tela /saude sem estar logado: acrescente
# ?chave=<valor> ao endereço. Existe para o dia em que ninguém consegue entrar.
# Sem ela, /saude mostra só o estado geral. Use um valor longo e sorteado.
STGAME_SAUDE_CHAVE=
