# Credenciais do navegador (publicas por natureza; e a chave publishable).
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="cole-aqui-a-chave-publishable"
VITE_SUPABASE_PROJECT_ID="seu-projeto"

# Mesmas credenciais para o lado servidor (sem o prefixo VITE_).
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="cole-aqui-a-chave-publishable"
SUPABASE_PROJECT_ID="seu-projeto"

# Para onde o link do convite leva. Precisa bater com a lista de URLs
# permitidas no Supabase (Authentication -> URL Configuration).
SITE_URL="http://localhost:8080"

# SEGREDO. Da acesso total ao banco, ignorando a RLS.
# Nunca use o prefixo VITE_ aqui: isso a mandaria para o navegador.
# Pegue em: Supabase -> Project Settings -> API Keys -> service_role (Reveal).
SUPABASE_SERVICE_ROLE_KEY=""
